# ============================================================================
# Storefront environment variables (example / template)
# ============================================================================
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored — never commit it.

# Publishable API key for the Medusa backend.
# Required for the storefront to function.
# Create one in: Medusa Admin -> Settings -> Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to redirect the bare URL to.
# Must match a country code that exists in your Medusa regions.
# (e.g. "us", "gb", "vn", "dk")
NEXT_PUBLIC_DEFAULT_REGION=vn

# Base URL of the storefront (used for generating absolute URLs in metadata,
# sitemaps, and OpenGraph tags).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe publishable key for payment processing (optional, only if using Stripe).
# Get this from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments).
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments).
MEDUSA_CLOUD_S3_BUCKET=

# Node environment (development, production, etc.)
NODE_ENV=development
